{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SocDb": "Host=localhost;Port=5436;Database=soc_db;Username=postgres;Password=devpassword"
  },
  "GraphSync": {
    "Key": ""
  },
  "SocIngest": {
    "Key": ""
  },
  "DetectionRules": {
    "FailedLogins": { "Threshold": 5, "WindowMinutes": 5 },
    "UnauthorisedAccess": { "Threshold": 3, "WindowMinutes": 5 },
    "RequestRate": { "Threshold": 100, "WindowSeconds": 60 },
    "ServiceFailure": { "Threshold": 3, "WindowMinutes": 2 },
    "GraphAccess": {
      "Threshold": 3,
      "WindowMinutes": 5,
      "SensitivePathPrefixes": [ "/api/graph/", "/api/rag/" ]
    },
    "EngineIntervalSeconds": 15
  },
  "Jwt": {
    "Key": "this-is-a-dev-only-secret-key-change-me-1234567890",
    "Issuer": "SquashPlatform",
    "Audience": "SquashPlatformClients",
    "ExpiryMinutes":  60
  }
}
