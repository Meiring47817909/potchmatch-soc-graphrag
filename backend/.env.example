# Copy to backend/.env (git-ignored). docker compose reads it automatically.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# After adding or changing the key, recreate the container so it picks the new value up
# (a plain `docker compose restart` keeps the old environment):
#   docker compose up -d rag-service
# Gemini 2.5 thinking budget in tokens. 0 turns thinking off (fastest). Leave empty to omit
# the setting for models that do not support it.
GEMINI_THINKING_BUDGET=0
